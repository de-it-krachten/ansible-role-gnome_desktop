---

# Generic
generic:
  role: ansible-role-gnome_desktop
  role_short: gnome_desktop
  role_description: |
    Install the Gnome 3.x desktop
    Primary goal of this role, is to mke it easy to install the Gnome desktop onto headless Vagrant boxes,
    when testing code onto vm's that require a desktop environment. 

# Supported platforms
platforms:
  rhel9:
    supported: false
    ci: false
  rhel10:
    supported: false
    ci: false
  rockylinux9:
    supported: false
    ci: false
  rockylinux10:
    supported: false
    ci: false
  almalinux9:
    supported: false
    ci: false
  almalinux10:
    supported: false
    ci: false
  ubuntu2004:
    supported: true
    ci: true
  ubuntu2204:
    supported: true
    ci: false

# Dependencies
dependencies:
  roles:
    - deitkrachten.facts
    - deitkrachten.package

# Molecule
molecule:
  prepare:
    vars:
      install_python: true
  converge:
    vars:
      hashicorp_product: vagrant
  requirements:
    roles_extra:
      - deitkrachten.facts
      - deitkrachten.package
  host_vars:
    gnome_desktop-{{ platform.name }}-node1:
      gnome_desktop_minimal: true
